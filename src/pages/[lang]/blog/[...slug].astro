---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../../../utils/i18n';
import '../../../styles/typography.css';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: {
      lang: post.data.lang,
      slug: post.id.split('/').pop(),
    },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={post.data.title}>
  <main class="container mx-auto px-4 py-10 md:px-6 md:py-16 w-full max-w-6xl">
    <div class="mb-8">
      <a href={`/${lang}/blog`} class="inline-flex items-center text-sm font-medium text-text-muted hover:text-accent transition-colors">
        <svg class="w-5 h-5 mr-2 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        {t('blog.back')}
      </a>
    </div>

    <article class="prose prose-lg md:prose-xl dark:prose-invert prose-primary mx-auto w-full max-w-none">
      <header class="mb-10 text-center max-w-5xl mx-auto">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight mb-6 text-text-primary leading-tight">
          {post.data.title}
        </h1>
        <div class="flex items-center justify-center text-text-muted font-medium">
          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString(lang, { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
          <span class="mx-3">•</span>
          <span>{Math.ceil(post.body.split(/\s+/).length / 200)} {t('blog.readTime')}</span>
        </div>
      </header>

      {post.data.image && (
        <div class="aspect-[16/8.5] w-full rounded-2xl overflow-hidden mb-12 shadow-xl border border-border-subtle">
          <Image
            src={post.data.image}
            alt={post.data.title}
            width={1400}
            height={744}
            class="w-full h-full object-cover m-0"
          />
        </div>
      )}

      <div class="bg-bg-card rounded-3xl md:px-2 md:py-4 lg:px-4">
        <Content />
      </div>
    </article>
  </main>
</Layout>
