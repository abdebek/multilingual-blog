---
import { languages } from '../../i18n/ui';

const { lang } = Astro.props;
---

<div class="relative inline-block text-left">
  <button
    type="button"
    class="inline-flex items-center gap-2 px-3 py-2 text-sm rounded-md hover:bg-bg-hover transition-colors"
    id="language-button"
    aria-expanded="false"
    aria-haspopup="true"
  >
    {languages[lang]}
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <div
    class="hidden absolute right-0 mt-2 w-36 rounded-md shadow-lg bg-bg-card ring-1 ring-black/5 focus:outline-none rtl:right-auto rtl:left-0 border border-border"
    role="menu"
    id="language-menu"
  >
    <div class="py-1" role="none">
      {Object.entries(languages).map(([code, label]) => {
        const segments = Astro.url.pathname.split('/').filter(Boolean);
        if (segments[0] in languages) {
          segments[0] = code;
        } else {
          segments.unshift(code);
        }
        const newPath = '/' + segments.join('/') + Astro.url.search;

        return (
          <a
            href={newPath}
            class:list={[
              'block px-4 py-2 text-sm hover:bg-bg-hover transition-colors',
              code === lang ? 'text-text-primary font-medium' : 'text-text-secondary'
            ]}
            role="menuitem"
          >
            {label}
          </a>
        );
      })}
    </div>
  </div>
</div>

<script>
  const button = document.getElementById('language-button');
  const menu = document.getElementById('language-menu');

  const toggleMenu = () => {
    const isHidden = menu?.classList.toggle('hidden');
    button?.setAttribute('aria-expanded', String(!isHidden));
  };
  const hideMenu = (e) => {
    if (!button?.contains(e.target) && !menu?.contains(e.target)) {
      menu?.classList.add('hidden');
      button?.setAttribute('aria-expanded', 'false');
    }
  };

  button?.addEventListener('click', toggleMenu);
  document.addEventListener('click', hideMenu);
</script>