---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import BlogCard from '../../../components/BlogCard.astro';
import { getLangFromUrl, useTranslations } from '../../../utils/i18n';
import { languages } from '../../../i18n/ui';

export async function getStaticPaths({ paginate }: any) {
  const allPosts = await getCollection('blog');

  return Object.keys(languages).flatMap((lang) => {
    const filteredPosts = allPosts
      .filter((post) => post.data.lang === lang)
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

    return paginate(filteredPosts, {
      params: { lang },
      pageSize: 6,
    });
  });
}

const { page } = Astro.props;
const { lang } = Astro.params;
const t = useTranslations(lang as any);

const posts = page.data;
const featuredPost = page.currentPage === 1 ? posts[0] : null;
const otherPosts = page.currentPage === 1 ? posts.slice(1) : posts;

const pageNumbers = Array.from({ length: page.lastPage }, (_, i) => i + 1);
---

<Layout title={t('nav.blog')} description={t('blog.description')}>
  <div class="container mx-auto px-4 py-12 w-full max-w-7xl">
    <div class="mb-16 text-start">
      <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-gray-900 dark:text-white mb-4">
        {t('blog.title')}
      </h1>
      <p class="text-lg text-gray-500 dark:text-gray-400 max-w-2xl">
        {t('blog.description')}
      </p>
    </div>

    {posts.length > 0 ? (
      <div class="space-y-20">
        {featuredPost && (
          <section aria-labelledby="featured-heading">
            <h2 id="featured-heading" class="sr-only">{t('blog.featured')}</h2>
            <a
              href={`/${lang}/blog/${featuredPost.id.split('/').pop()}`}
              class="group relative block overflow-hidden rounded-3xl bg-white dark:bg-gray-800 shadow-sm transition-all duration-500 hover:shadow-2xl border border-gray-100 dark:border-gray-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500"
            >
              <div class="grid grid-cols-1 lg:grid-cols-2">
                <div class="aspect-[16/10] lg:aspect-auto lg:min-h-[20rem] overflow-hidden relative">
                  {featuredPost.data.image ? (
                    <Image
                      src={featuredPost.data.image}
                      alt={featuredPost.data.title}
                      width={1200}
                      height={800}
                      class="h-full w-full object-cover transition-transform duration-700 motion-safe:group-hover:scale-105"
                    />
                  ) : (
                    <div class="h-full w-full bg-gradient-to-br from-primary-800 to-primary-950 flex items-center justify-center">
                       <svg class="w-24 h-24 text-white/20" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                       </svg>
                    </div>
                  )}
                </div>
                <div class="p-8 md:p-12 lg:p-12 flex flex-col justify-center text-start">
                  <div class="flex flex-wrap items-center gap-3 mb-6">
                    <span class="px-3 py-1 bg-primary-100 dark:bg-primary-900/40 text-primary-700 dark:text-primary-300 text-xs font-bold uppercase tracking-wider rounded-full">
                      {t('blog.latest')}
                    </span>
                    <span class="text-gray-400 dark:text-gray-500 text-sm" aria-hidden="true">•</span>
                    <time datetime={featuredPost.data.pubDate.toISOString()} class="text-sm text-gray-500 dark:text-gray-400 font-medium">
                      {featuredPost.data.pubDate.toLocaleDateString(lang, { year: 'numeric', month: 'long', day: 'numeric' })}
                    </time>
                  </div>
                  <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 dark:text-white mb-6 leading-tight group-hover:text-primary-700 dark:group-hover:text-primary-300 transition-colors duration-300">
                    {featuredPost.data.title}
                  </h2>
                  <p class="text-lg text-gray-600 dark:text-gray-400 mb-8 leading-relaxed line-clamp-3">
                    {featuredPost.data.description}
                  </p>
                  <div class="flex items-center text-primary-700 dark:text-primary-300 font-bold">
                    {t('blog.readFull')}
                    <svg class="ms-2 w-5 h-5 transition-transform duration-300 motion-safe:group-hover:translate-x-2 rtl:rotate-180 rtl:motion-safe:group-hover:-translate-x-2 rtl:motion-safe:group-hover:translate-x-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                    </svg>
                  </div>
                </div>
              </div>
            </a>
          </section>
        )}

        <section aria-labelledby="posts-heading">
          <div class="flex items-center justify-between mb-12 gap-4">
            <h2 id="posts-heading" class="text-2xl font-bold tracking-tight text-gray-900 dark:text-white">
              {page.currentPage === 1 ? t('blog.more') : `${t('blog.title')} — ${t('pagination.page')} ${page.currentPage}`}
            </h2>
            <div class="h-px flex-1 bg-gray-100 dark:bg-gray-800 ms-8 hidden sm:block" aria-hidden="true"></div>
          </div>

          {otherPosts.length > 0 ? (
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
              {otherPosts.map((post) => (
                <BlogCard
                  title={post.data.title}
                  description={post.data.description}
                  url={`/${lang}/blog/${post.id.split('/').pop()}`}
                  pubDate={post.data.pubDate}
                  image={post.data.image}
                  lang={lang || 'en'}
                />
              ))}
            </div>
          ) : (
            page.currentPage === 1 && posts.length === 1 ? null : (
              <p class="text-gray-500 dark:text-gray-400">{t('blog.noPosts')}</p>
            )
          )}
        </section>

        {page.lastPage > 1 && (
          <nav class="flex flex-wrap justify-center items-center gap-3 mt-16 pt-12 border-t border-gray-100 dark:border-gray-800" aria-label={t('pagination.page')}>
            {page.url.prev ? (
              <a
                href={page.url.prev}
                class="inline-flex items-center gap-2 px-5 py-2.5 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-200 rounded-full font-bold border border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700 transition-all shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500"
                rel="prev"
              >
                <svg class="w-5 h-5 rtl:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l-7 7m0 0l7 7m-7-7h18" /></svg>
                {t('pagination.previous')}
              </a>
            ) : (
              <span class="inline-flex items-center gap-2 px-5 py-2.5 bg-gray-50 dark:bg-gray-900 text-gray-400 dark:text-gray-500 rounded-full font-bold border border-gray-100 dark:border-gray-800 cursor-not-allowed" aria-disabled="true">
                <svg class="w-5 h-5 rtl:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l-7 7m0 0l7 7m-7-7h18" /></svg>
                {t('pagination.previous')}
              </span>
            )}

            <div class="flex items-center gap-1" role="list">
              {pageNumbers.map((n) => (
                n === page.currentPage ? (
                  <span
                    role="listitem"
                    class="min-w-[2.5rem] h-10 inline-flex items-center justify-center rounded-full bg-primary-700 text-white text-sm font-bold"
                    aria-current="page"
                  >
                    {n}
                  </span>
                ) : (
                  <a
                    role="listitem"
                    href={n === 1 ? `/${lang}/blog` : `/${lang}/blog/${n}`}
                    class="min-w-[2.5rem] h-10 inline-flex items-center justify-center rounded-full text-sm font-medium text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500"
                  >
                    {n}
                  </a>
                )
              ))}
            </div>

            <span class="sr-only">
              {t('pagination.page')} {page.currentPage} {t('pagination.of')} {page.lastPage}
            </span>

            {page.url.next ? (
              <a
                href={page.url.next}
                class="inline-flex items-center gap-2 px-5 py-2.5 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-200 rounded-full font-bold border border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700 transition-all shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500"
                rel="next"
              >
                {t('pagination.next')}
                <svg class="w-5 h-5 rtl:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l7-7m0 0l-7-7m7 7H3" /></svg>
              </a>
            ) : (
              <span class="inline-flex items-center gap-2 px-5 py-2.5 bg-gray-50 dark:bg-gray-900 text-gray-400 dark:text-gray-500 rounded-full font-bold border border-gray-100 dark:border-gray-800 cursor-not-allowed" aria-disabled="true">
                {t('pagination.next')}
                <svg class="w-5 h-5 rtl:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l7-7m0 0l-7-7m7 7H3" /></svg>
              </span>
            )}
          </nav>
        )}
      </div>
    ) : (
      <div class="text-center py-24 bg-gray-50 dark:bg-gray-800/50 rounded-3xl border-2 border-dashed border-gray-200 dark:border-gray-700">
        <svg class="w-16 h-16 mx-auto mb-6 text-gray-300 dark:text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
        </svg>
        <p class="text-xl text-gray-500 dark:text-gray-400 font-medium">
          {t('blog.noPosts')}
        </p>
      </div>
    )}
  </div>
</Layout>
