---
import Logo from './Logo.astro';
import NavLinks from './NavLinks.astro';
import LanguageDropdown from './LanguageDropdown.astro';
import ThemeSelector from '../ThemeSelector.astro';
import Search from '../Search.astro';
import { getLangFromUrl } from '../../utils/i18n';

const lang = getLangFromUrl(Astro.url);
---
<header id="site-header" class:list={[
  'fixed top-0 left-0 right-0 z-[100] transition-all duration-300',
  'px-4 h-16 md:h-20',
  lang === 'ar' ? 'font-cairo' : ''
]}>
  <div class="max-w-7xl mx-auto h-full flex items-center justify-between gap-4">
    <Logo lang={lang} />
    <div class="flex items-center gap-3 md:gap-8">
      <NavLinks lang={lang} />
      <div class="flex items-center gap-2 md:gap-4 border-l border-border pl-2 md:pl-6 rtl:border-l-0 rtl:border-r rtl:pl-0 rtl:pr-2 md:rtl:pr-6">
        <div class="hidden sm:block">
          <Search lang={lang} />
        </div>
        <div class="sm:hidden">
          <Search lang={lang} mobile={true} />
        </div>
        <div class="flex items-center gap-2">
          <ThemeSelector lang={lang} />
          <LanguageDropdown lang={lang} />
        </div>
      </div>
    </div>
  </div>
</header>

<!-- Spacer to prevent content jump -->
<div class="h-16 md:h-20"></div>

<script is:inline>
  (function() {
    const header = document.getElementById('site-header');
    if (!header) return;

    let ticking = false;
    let wasScrolled = false;

    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        const scrolled = window.scrollY > 10;
        if (scrolled === wasScrolled) return;
        wasScrolled = scrolled;
        if (scrolled) {
          header.classList.add('bg-bg-card/90', 'backdrop-blur-xl', 'border-b', 'border-border/80', 'shadow-lg');
          header.classList.remove('bg-transparent');
        } else {
          header.classList.remove('bg-bg-card/90', 'backdrop-blur-xl', 'border-b', 'border-border/80', 'shadow-lg');
          header.classList.add('bg-transparent');
        }
      });
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();
</script>