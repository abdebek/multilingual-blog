---
import { useTranslations } from '../utils/i18n';
import { getLangFromUrl } from '../utils/i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Configure real profile URLs in production; empty hrefs are omitted
const socialLinks = [
  {
    href: 'https://x.com',
    label: 'social.twitter',
    path: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z'
  },
  {
    href: 'https://github.com',
    label: 'social.github',
    path: 'M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z'
  },
].filter((s) => s.href);

const footerLinks = [
  { href: `/${lang}/blog`, label: t('nav.blog') },
  { href: `/${lang}/about`, label: t('nav.about') },
  { href: `/${lang}/contact`, label: t('nav.contact') },
  { href: `/${lang}/privacy-policy`, label: t('footer.privacyPolicy') },
  { href: `/${lang}/rss.xml`, label: t('footer.rss') },
];

const currentYear = new Date().getFullYear();
---
<footer class:list={[
  'bg-white dark:bg-gray-900 border-t border-gray-200 dark:border-gray-800',
  'px-4 py-12 md:py-16 mt-auto',
  lang === 'ar' ? 'font-cairo' : ''
]}>
  <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-8">
    <div class="lg:col-span-2 text-start">
      <p class="text-2xl font-bold text-gray-900 dark:text-white mb-4 tracking-tight">{t('footer.tagline')}</p>
      <p class="text-gray-600 dark:text-gray-400 max-w-md leading-relaxed">{t('footer.description')}</p>
    </div>

    <div class="text-start">
      <p class="text-sm font-bold text-gray-900 dark:text-white uppercase tracking-wider mb-6">{t('footer.linksTitle')}</p>
      <ul class="space-y-4">
        {footerLinks.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class="text-gray-600 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors font-medium focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 rounded-sm"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="text-start">
      <p class="text-sm font-bold text-gray-900 dark:text-white uppercase tracking-wider mb-6">{t('footer.followUs')}</p>
      <div class="flex gap-5">
        {socialLinks.map(({ href, path, label }) => (
          <a
            href={href}
            class="text-gray-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors motion-safe:hover:-translate-y-1 duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 rounded-sm"
            aria-label={t(label)}
            rel="noopener noreferrer"
            target="_blank"
          >
            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d={path} />
            </svg>
          </a>
        ))}
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto mt-16 pt-8 border-t border-gray-200 dark:border-gray-800 flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-gray-500 dark:text-gray-500 text-center md:text-start">
    <p>&copy; {currentYear} {t('site.title')}. {t('footer.rightsReserved')}</p>
    <blockquote class="italic font-serif border-s-2 border-primary-600 ps-4 md:border-s-0 md:ps-0">
      &ldquo;{t('footer.quote')}&rdquo;
    </blockquote>
  </div>
</footer>
