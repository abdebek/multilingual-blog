---
import { useTranslations } from '../utils/i18n';

const { lang } = Astro.props;
const t = useTranslations(lang);
// Default: Cloudflare Pages Function. Override with Formspree etc. via env.
const contactEndpoint =
  import.meta.env.PUBLIC_CONTACT_ENDPOINT || '/api/contact';
---

<div class="max-w-xl mx-auto">
  <form
    id="contact-form"
    name="contact"
    method="POST"
    action={contactEndpoint}
    class="space-y-8 bg-white dark:bg-gray-800 p-8 md:p-12 rounded-3xl shadow-xl border border-gray-100 dark:border-gray-700 transition-all duration-500"
    novalidate
  >
    <!-- Honeypot (hidden from users) -->
    <p class="hidden" aria-hidden="true">
      <label>
        Don’t fill this out: <input name="bot-field" tabindex="-1" autocomplete="off" />
      </label>
    </p>

    <div class="space-y-2">
      <label for="name" class="block text-sm font-bold text-gray-700 dark:text-gray-300 uppercase tracking-wider">
        {t('contact.form.name')}
      </label>
      <input
        type="text"
        id="name"
        name="name"
        required
        autocomplete="name"
        placeholder={t('contact.form.namePlaceholder')}
        class="w-full px-5 py-4 rounded-xl border border-gray-200 dark:border-gray-600 bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all outline-none"
      />
    </div>

    <div class="space-y-2">
      <label for="email" class="block text-sm font-bold text-gray-700 dark:text-gray-300 uppercase tracking-wider">
        {t('contact.form.email')}
      </label>
      <input
        type="email"
        id="email"
        name="email"
        required
        autocomplete="email"
        placeholder={t('contact.form.emailPlaceholder')}
        class="w-full px-5 py-4 rounded-xl border border-gray-200 dark:border-gray-600 bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all outline-none"
      />
    </div>

    <div class="space-y-2">
      <label for="message" class="block text-sm font-bold text-gray-700 dark:text-gray-300 uppercase tracking-wider">
        {t('contact.form.message')}
      </label>
      <textarea
        id="message"
        name="message"
        rows="5"
        required
        placeholder={t('contact.form.messagePlaceholder')}
        class="w-full px-5 py-4 rounded-xl border border-gray-200 dark:border-gray-600 bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all outline-none resize-y min-h-[8rem]"
      ></textarea>
    </div>

    <button
      type="submit"
      id="submit-button"
      class="w-full bg-primary-700 hover:bg-primary-800 text-white font-bold py-4 px-8 rounded-xl shadow-md shadow-primary-950/15 hover:shadow-lg motion-safe:hover:-translate-y-0.5 transition-all duration-300 flex items-center justify-center gap-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 disabled:opacity-70 disabled:cursor-not-allowed disabled:hover:translate-y-0"
    >
      <span id="button-text">{t('contact.form.submit')}</span>
      <div id="loading-spinner" class="hidden w-5 h-5 border-2 border-white/30 border-t-white rounded-full animate-spin" aria-hidden="true"></div>
    </button>
  </form>

  <div
    id="success-message"
    class="hidden mt-8 p-8 bg-emerald-50 dark:bg-emerald-900/20 border border-emerald-100 dark:border-emerald-800 rounded-3xl text-center"
    role="status"
    aria-live="polite"
  >
    <div class="w-16 h-16 bg-emerald-100 dark:bg-emerald-900/40 text-emerald-600 dark:text-emerald-400 rounded-full flex items-center justify-center mx-auto mb-4">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
      </svg>
    </div>
    <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">{t('contact.success.title')}</h3>
    <p class="text-gray-600 dark:text-gray-400 mb-6">{t('contact.success.message')}</p>
    <button
      type="button"
      id="send-another"
      class="inline-flex items-center gap-2 px-6 py-3 rounded-full font-bold bg-emerald-600 hover:bg-emerald-700 text-white transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500"
    >
      {t('contact.success.another')}
    </button>
  </div>

  <div
    id="error-message"
    class="hidden mt-8 p-6 bg-red-50 dark:bg-red-900/20 border border-red-100 dark:border-red-800 rounded-3xl text-center"
    role="alert"
    aria-live="assertive"
  >
    <p class="text-red-600 dark:text-red-400 font-medium mb-4">{t('contact.error')}</p>
    <button
      type="button"
      id="dismiss-error"
      class="text-sm font-semibold text-red-700 dark:text-red-300 underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-500 rounded"
    >
      {t('contact.error.dismiss')}
    </button>
  </div>
</div>

<script is:inline define:vars={{ contactEndpoint }}>
  (function () {
    const form = document.getElementById('contact-form');
    const successMessage = document.getElementById('success-message');
    const errorMessage = document.getElementById('error-message');
    const submitButton = document.getElementById('submit-button');
    const buttonText = document.getElementById('button-text');
    const loadingSpinner = document.getElementById('loading-spinner');
    const sendAnother = document.getElementById('send-another');
    const dismissError = document.getElementById('dismiss-error');

    const setLoading = (loading) => {
      if (!submitButton || !buttonText || !loadingSpinner) return;
      submitButton.disabled = loading;
      submitButton.setAttribute('aria-busy', loading ? 'true' : 'false');
      buttonText.classList.toggle('opacity-50', loading);
      loadingSpinner.classList.toggle('hidden', !loading);
    };

    const showSuccess = () => {
      form?.classList.add('hidden');
      errorMessage?.classList.add('hidden');
      successMessage?.classList.remove('hidden');
    };

    const showError = () => {
      errorMessage?.classList.remove('hidden');
      setLoading(false);
    };

    const resetToForm = () => {
      successMessage?.classList.add('hidden');
      errorMessage?.classList.add('hidden');
      form?.classList.remove('hidden');
      form?.reset();
      setLoading(false);
      document.getElementById('name')?.focus();
    };

    sendAnother?.addEventListener('click', resetToForm);
    dismissError?.addEventListener('click', () => {
      errorMessage?.classList.add('hidden');
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorMessage?.classList.add('hidden');
      setLoading(true);

      const formData = new FormData(form);

      try {
        const isFormspree = /formspree\.io/i.test(contactEndpoint);
        const res = await fetch(contactEndpoint, {
          method: 'POST',
          headers: isFormspree
            ? { Accept: 'application/json', 'Content-Type': 'application/json' }
            : { Accept: 'application/json', 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: formData.get('name'),
            email: formData.get('email'),
            message: formData.get('message'),
            'bot-field': formData.get('bot-field') || '',
          }),
        });

        if (!res.ok) throw new Error('Submit failed');

        // Formspree returns 200 with ok; our API returns { ok: true }
        const data = await res.json().catch(() => ({}));
        if (data && data.ok === false) throw new Error('Submit failed');

        showSuccess();
        setLoading(false);
      } catch (error) {
        showError();
      }
    });
  })();
</script>
