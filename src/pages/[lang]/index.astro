---
import Layout from '../../layouts/Layout.astro';
import BlogCard from '../../components/BlogCard.astro';
import ScrollReveal from '../../components/ScrollReveal.astro';
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations } from '../../utils/i18n';
import { languages } from '../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const posts = await getCollection('blog', ({ data }) => data.lang === lang);
const latestPosts = posts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const langCount = Object.keys(languages).length;
const postCount = posts.length;

const features = [
  {
    key: 'multilingual',
    title: t('home.features.multilingual.title'),
    desc: t('home.features.multilingual.desc'),
    icon: 'globe',
  },
  {
    key: 'craft',
    title: t('home.features.craft.title'),
    desc: t('home.features.craft.desc'),
    icon: 'book',
  },
  {
    key: 'open',
    title: t('home.features.open.title'),
    desc: t('home.features.open.desc'),
    icon: 'bolt',
  },
] as const;
---

<Layout title={t('site.title')} description={t('site.description')}>
  <div class="flex flex-col items-center overflow-x-clip">
    <!-- ─── Hero ─── -->
    <section
      class="w-full relative min-h-[min(92vh,52rem)] flex flex-col justify-center border-b border-gray-200/80 dark:border-gray-800 overflow-hidden"
      data-hero-parallax
      aria-labelledby="hero-heading"
    >
      <!-- Atmosphere -->
      <div class="absolute inset-0 bg-gradient-to-b from-primary-50/90 via-white to-gray-50 dark:from-gray-950 dark:via-gray-900 dark:to-gray-900" aria-hidden="true"></div>
      <div
        class="hero-orb absolute -top-24 -start-24 w-[28rem] h-[28rem] bg-primary-300/40 dark:bg-primary-700/25"
        data-parallax-layer
        data-parallax-speed="0.2"
        aria-hidden="true"
      ></div>
      <div
        class="hero-orb hero-orb-slow absolute top-1/3 -end-32 w-[24rem] h-[24rem] bg-primary-400/25 dark:bg-primary-600/20"
        data-parallax-layer
        data-parallax-speed="0.35"
        style="animation-delay: -6s"
        aria-hidden="true"
      ></div>
      <div
        class="hero-orb absolute -bottom-20 start-1/3 w-[20rem] h-[20rem] bg-primary-200/50 dark:bg-primary-800/20"
        data-parallax-layer
        data-parallax-speed="0.12"
        style="animation-delay: -11s"
        aria-hidden="true"
      ></div>
      <div class="absolute inset-0 hero-grid opacity-60 dark:opacity-30" data-parallax-layer data-parallax-speed="0.08" aria-hidden="true"></div>
      <div class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-gray-50 dark:from-gray-900 to-transparent pointer-events-none" aria-hidden="true"></div>

      <div class="container mx-auto px-4 py-24 md:py-28 relative z-10 text-center max-w-5xl">
        <p class="hero-enter inline-flex items-center gap-2 px-3.5 py-1.5 mb-8 rounded-full text-xs font-semibold uppercase tracking-wider text-primary-800 dark:text-primary-200 bg-white/70 dark:bg-gray-800/70 border border-primary-200/80 dark:border-primary-800/60 backdrop-blur-md shadow-sm">
          <span class="relative flex h-2 w-2" aria-hidden="true">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary-400 opacity-40"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-primary-600 dark:bg-primary-400"></span>
          </span>
          {t('home.hero.badge')}
        </p>

        <h1 id="hero-heading" class="hero-enter hero-enter-delay-1 text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tight mb-6 leading-[1.08] text-gray-900 dark:text-white">
          <span class="block">{t('home.hero.title.lead')}</span>
          <span class="block text-gradient-hero mt-1 sm:mt-2">{t('home.hero.title.accent')}</span>
        </h1>

        <p class="hero-enter hero-enter-delay-2 text-lg md:text-xl lg:text-2xl text-gray-600 dark:text-gray-300 leading-relaxed mb-10 max-w-2xl mx-auto">
          {t('site.description')}
        </p>

        <div class="hero-enter hero-enter-delay-3 flex flex-wrap items-center justify-center gap-3 sm:gap-4 mb-12">
          <a
            href={`/${lang}/blog`}
            class="btn-shine px-8 py-3.5 bg-primary-700 hover:bg-primary-800 text-white rounded-full font-semibold transition-all shadow-lg shadow-primary-950/15 hover:shadow-xl motion-safe:hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2"
          >
            {t('home.hero.cta.blog')}
          </a>
          <a
            href={`/${lang}/about`}
            class="px-8 py-3.5 bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm text-gray-800 dark:text-gray-100 border border-gray-200/90 dark:border-gray-700 rounded-full font-semibold transition-all hover:bg-white dark:hover:bg-gray-800 hover:border-primary-300 dark:hover:border-primary-700 motion-safe:hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2"
          >
            {t('home.hero.cta.secondary')}
          </a>
        </div>

        <!-- Language + stats chips -->
        <div class="hero-enter hero-enter-delay-4 flex flex-wrap items-center justify-center gap-3 sm:gap-4 text-sm">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-2xl bg-white/60 dark:bg-gray-800/50 border border-gray-200/80 dark:border-gray-700 backdrop-blur-md shadow-sm">
            <span class="font-bold text-primary-800 dark:text-primary-200 tabular-nums">{langCount}</span>
            <span class="text-gray-600 dark:text-gray-400">{t('home.hero.stat.langs')}</span>
            <span class="text-gray-300 dark:text-gray-600" aria-hidden="true">·</span>
            {Object.entries(languages).map(([code, label]) => (
              <a
                href={`/${code}/`}
                hreflang={code}
                lang={code}
                class:list={[
                  'px-2 py-0.5 rounded-md font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500',
                  code === lang
                    ? 'bg-primary-100 dark:bg-primary-900/50 text-primary-800 dark:text-primary-200'
                    : 'text-gray-500 dark:text-gray-400 hover:text-primary-700 dark:hover:text-primary-300'
                ]}
                aria-current={code === lang ? 'page' : undefined}
              >
                {label}
              </a>
            ))}
          </div>
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-2xl bg-white/60 dark:bg-gray-800/50 border border-gray-200/80 dark:border-gray-700 backdrop-blur-md shadow-sm text-gray-600 dark:text-gray-400">
            <span class="font-bold text-gray-900 dark:text-white tabular-nums">{postCount}</span>
            {t('home.hero.stat.posts')}
          </div>
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-2xl bg-white/60 dark:bg-gray-800/50 border border-gray-200/80 dark:border-gray-700 backdrop-blur-md shadow-sm text-gray-600 dark:text-gray-400">
            {t('home.hero.stat.rtl')}
          </div>
        </div>
      </div>

      <a
        href="#features"
        class="hero-enter hero-enter-delay-5 absolute bottom-8 start-1/2 -translate-x-1/2 rtl:translate-x-1/2 flex flex-col items-center gap-2 text-xs font-medium text-gray-500 dark:text-gray-400 hover:text-primary-700 dark:hover:text-primary-300 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 rounded-lg px-2 py-1"
      >
        <span class="sr-only sm:not-sr-only sm:inline">{t('home.hero.scroll')}</span>
        <span class="scroll-hint inline-flex h-9 w-5 items-start justify-center rounded-full border-2 border-current/40 p-1" aria-hidden="true">
          <span class="block h-1.5 w-1 rounded-full bg-current"></span>
        </span>
      </a>
    </section>

    <div class="container mx-auto px-4 py-20 md:py-24 w-full max-w-7xl">
      <!-- ─── Features ─── -->
      <section id="features" class="mb-24 md:mb-28" aria-labelledby="features-heading">
        <div class="text-center max-w-2xl mx-auto mb-12 md:mb-16 reveal" data-reveal>
          <h2 id="features-heading" class="text-3xl md:text-4xl font-bold tracking-tight text-gray-900 dark:text-white mb-3">
            {t('home.features.title')}
          </h2>
          <p class="text-gray-500 dark:text-gray-400 text-lg leading-relaxed">
            {t('home.features.desc')}
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
          {features.map((f, i) => (
            <article
              data-reveal
              class:list={[
                'reveal card-lift group p-8 rounded-3xl bg-white dark:bg-gray-800/80 border border-gray-100 dark:border-gray-700/80 text-start shadow-sm',
                i === 1 ? 'reveal-delay-1' : i === 2 ? 'reveal-delay-2' : ''
              ]}
            >
              <div class="w-12 h-12 mb-6 rounded-2xl bg-primary-100 dark:bg-primary-900/40 text-primary-700 dark:text-primary-300 flex items-center justify-center transition-transform duration-500 motion-safe:group-hover:scale-110">
                {f.icon === 'globe' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 21a9 9 0 100-18 9 9 0 000 18zM3.6 9h16.8M3.6 15h16.8M12 3c2.5 2.7 4 6.1 4 9s-1.5 6.3-4 9c-2.5-2.7-4-6.1-4-9s1.5-6.3 4-9z" />
                  </svg>
                )}
                {f.icon === 'book' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4 19.5A2.5 2.5 0 016.5 17H20M4 19.5A2.5 2.5 0 016.5 22H20V2H6.5A2.5 2.5 0 004 4.5v15z" />
                  </svg>
                )}
                {f.icon === 'bolt' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M13 2L4 14h7l-1 8 9-12h-7l1-8z" />
                  </svg>
                )}
              </div>
              <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2 tracking-tight">{f.title}</h3>
              <p class="text-gray-600 dark:text-gray-400 leading-relaxed text-[0.95rem]">{f.desc}</p>
            </article>
          ))}
        </div>
      </section>

      <!-- ─── Latest posts ─── -->
      {latestPosts.length > 0 && (
        <section class="mb-24 md:mb-28" aria-labelledby="latest-heading">
          <div class="flex justify-between items-end mb-10 gap-4 reveal" data-reveal>
            <div class="text-start">
              <h2 id="latest-heading" class="text-3xl md:text-4xl font-bold tracking-tight text-gray-900 dark:text-white mb-2">
                {t('home.latest.title')}
              </h2>
              <p class="text-gray-500 dark:text-gray-400">{t('home.latest.desc')}</p>
            </div>
            <a
              href={`/${lang}/blog`}
              class="hidden md:inline-flex items-center text-primary-700 hover:text-primary-800 dark:text-primary-300 dark:hover:text-primary-200 font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 rounded-sm group"
            >
              {t('home.latest.viewAll')}
              <svg class="w-5 h-5 ms-1 transition-transform duration-300 motion-safe:group-hover:translate-x-1 rtl:rotate-180 rtl:motion-safe:group-hover:-translate-x-1 rtl:motion-safe:group-hover:translate-x-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {latestPosts.map((post, i) => (
              <div data-reveal class:list={['reveal', i === 1 ? 'reveal-delay-1' : i === 2 ? 'reveal-delay-2' : '']}>
                <BlogCard
                  title={post.data.title}
                  description={post.data.description}
                  url={`/${lang}/blog/${post.id.split('/').pop()}`}
                  pubDate={post.data.pubDate}
                  image={post.data.image}
                  lang={lang}
                />
              </div>
            ))}
          </div>
          <div class="mt-10 md:hidden flex justify-center reveal" data-reveal>
            <a
              href={`/${lang}/blog`}
              class="px-6 py-3 border border-gray-200 dark:border-gray-700 rounded-full text-gray-600 dark:text-gray-300 font-medium hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors w-full text-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500"
            >
              {t('home.latest.viewAll')}
            </a>
          </div>
        </section>
      )}

      <!-- ─── Mission ─── -->
      <section
        class="mb-24 md:mb-28 rounded-[2rem] overflow-hidden border border-gray-100 dark:border-gray-800 bg-white dark:bg-gray-800/60 shadow-sm"
        aria-labelledby="mission-heading"
      >
        <div class="grid grid-cols-1 lg:grid-cols-5">
          <div class="lg:col-span-3 p-8 md:p-12 lg:p-14 text-start reveal-left" data-reveal>
            <p class="text-xs font-bold uppercase tracking-widest text-primary-600 dark:text-primary-400 mb-3">
              {t('nav.about')}
            </p>
            <h2 id="mission-heading" class="text-2xl md:text-3xl font-bold mb-4 text-gray-900 dark:text-white tracking-tight">
              {t('about.mission.title')}
            </h2>
            <p class="text-gray-600 dark:text-gray-400 leading-relaxed text-lg max-w-xl mb-8">
              {t('about.mission.content')}
            </p>
            <a
              href={`/${lang}/about`}
              class="inline-flex items-center font-semibold text-primary-700 dark:text-primary-300 hover:text-primary-800 dark:hover:text-primary-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 rounded-sm group"
            >
              {t('nav.about')}
              <svg class="w-5 h-5 ms-1 transition-transform duration-300 motion-safe:group-hover:translate-x-1 rtl:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
          <div
            class="lg:col-span-2 relative min-h-[12rem] lg:min-h-full bg-gradient-to-br from-primary-800 via-primary-900 to-gray-950 p-10 flex items-center justify-center reveal-right"
            data-reveal
            aria-hidden="true"
          >
            <div class="absolute inset-0 opacity-20 bg-[radial-gradient(circle_at_30%_20%,white,transparent_55%)]"></div>
            <div class="relative text-center text-primary-100/90">
              <p class="text-5xl md:text-6xl font-extrabold tracking-tight text-white mb-2 tabular-nums">{langCount}</p>
              <p class="text-sm font-medium uppercase tracking-widest text-primary-200/80">{t('home.hero.stat.langs')}</p>
            </div>
          </div>
        </div>
      </section>

      <!-- ─── CTA ─── -->
      <section
        class="max-w-4xl mx-auto text-center rounded-[2rem] p-10 md:p-14 shadow-xl shadow-primary-950/20 relative overflow-hidden border border-primary-800/40 reveal-scale"
        data-reveal
        aria-labelledby="cta-heading"
      >
        <div class="absolute inset-0 bg-gradient-to-br from-primary-900 via-primary-950 to-gray-950" aria-hidden="true"></div>
        <div class="absolute inset-0 opacity-[0.08] bg-[radial-gradient(circle_at_30%_20%,white,transparent_55%)]" aria-hidden="true"></div>
        <div class="absolute -top-24 -end-24 w-64 h-64 rounded-full bg-primary-500/20 blur-3xl" aria-hidden="true"></div>
        <div class="relative z-10">
          <p class="text-xs font-bold uppercase tracking-widest text-primary-300/90 mb-3">{t('home.cta.kicker')}</p>
          <h2 id="cta-heading" class="text-3xl md:text-4xl font-bold mb-5 text-white tracking-tight">{t('contact.title')}</h2>
          <p class="text-primary-200/90 text-lg mb-9 max-w-2xl mx-auto leading-relaxed">{t('contact.intro')}</p>
          <a
            href={`/${lang}/contact`}
            class="btn-shine inline-block px-8 py-4 bg-white text-primary-900 hover:bg-primary-50 rounded-full font-bold shadow-md motion-safe:hover:-translate-y-1 transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-primary-950"
          >
            {t('contact.us')}
          </a>
        </div>
      </section>
    </div>
  </div>

  <ScrollReveal />
</Layout>
