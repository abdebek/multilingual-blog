    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.1",
    "astro": "^6.0.2",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260729.1",
    "@playwright/test": "^1.62.1",
    "decap-server": "^3.10.0",
    "pagefind": "^1.4.0",
    "wrangler": "^4.115.0"
  }
