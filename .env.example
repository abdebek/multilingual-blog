# Site URL (also set `site` in astro.config.mjs for sitemap/OG)
# PUBLIC_SITE_URL=https://your-domain.com

# --- Cloudflare Pages (dashboard secrets / bindings; not committed) ---
#
# GitHub OAuth (Decap CMS)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
#
# Cloudflare Email Service (send_email binding name: CONTACT_EMAIL)
# CONTACT_FROM_EMAIL=contact@your-domain.com   # verified sender domain
# CONTACT_TO_EMAIL=you@example.com
#
# Optional
# CONTACT_DEV_ACCEPT=1
# ALLOWED_ORIGINS=https://your-domain.com,https://your-project.pages.dev
