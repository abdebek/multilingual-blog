---
/**
 * Reading progress bar + table of contents for article pages.
 * Headings (h2/h3) inside #article-body get ids at runtime.
 */
import { useTranslations } from '../utils/i18n';

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div
  id="reading-progress"
  class="fixed top-0 inset-x-0 z-[110] h-0.5 pointer-events-none"
  role="progressbar"
  aria-valuemin="0"
  aria-valuemax="100"
  aria-valuenow="0"
  aria-label={t('blog.readingProgress')}
>
  <div
    id="reading-progress-bar"
    class="h-full w-0 bg-gradient-to-r from-primary-600 to-primary-400 transition-[width] duration-100 ease-out"
  ></div>
</div>

<aside
  id="article-toc"
  class="hidden xl:block fixed top-28 end-6 z-40 w-52 max-h-[min(70vh,28rem)] overflow-y-auto rounded-2xl border border-gray-200/80 dark:border-gray-700 bg-white/80 dark:bg-gray-900/80 backdrop-blur-md shadow-sm p-4 text-start"
  hidden
  aria-label={t('blog.toc')}
>
  <p class="text-[11px] font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-3">
    {t('blog.toc')}
  </p>
  <nav id="article-toc-nav" class="space-y-1 text-sm"></nav>
</aside>

<script is:inline define:vars={{ tocTitle: t('blog.toc') }}>
  (function () {
    let scrollBound = false;
    let articleEl = null;
    let headings = [];

    function slugify(text) {
      return String(text)
        .trim()
        .toLowerCase()
        .normalize('NFKD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[^\w\u0600-\u06FF\u00C0-\u024F\s-]/g, '')
        .replace(/\s+/g, '-')
        .replace(/-+/g, '-')
        .replace(/^-|-$/g, '') || 'section';
    }

    function uniqueId(base, used) {
      let id = base || 'section';
      let n = 2;
      while (used.has(id)) {
        id = base + '-' + n;
        n++;
      }
      used.add(id);
      return id;
    }

    function buildToc() {
      articleEl = document.getElementById('article-body');
      const toc = document.getElementById('article-toc');
      const nav = document.getElementById('article-toc-nav');
      if (!articleEl || !toc || !nav) return;

      const hs = articleEl.querySelectorAll('h2, h3');
      headings = Array.from(hs);
      nav.innerHTML = '';

      if (headings.length < 2) {
        toc.hidden = true;
        toc.classList.add('hidden');
        return;
      }

      const used = new Set();
      headings.forEach((h) => {
        if (!h.id) {
          h.id = uniqueId(slugify(h.textContent || ''), used);
        } else {
          used.add(h.id);
        }
        const a = document.createElement('a');
        a.href = '#' + h.id;
        a.textContent = h.textContent || '';
        a.className =
          (h.tagName === 'H3' ? 'ps-3 text-xs ' : '') +
          'block py-1.5 text-gray-600 dark:text-gray-400 hover:text-primary-700 dark:hover:text-primary-300 transition-colors rounded-md border-s-2 border-transparent hover:border-primary-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 toc-link';
        a.dataset.tocFor = h.id;
        nav.appendChild(a);
      });

      toc.hidden = false;
      toc.classList.remove('hidden');
    }

    function updateProgress() {
      const bar = document.getElementById('reading-progress-bar');
      const wrap = document.getElementById('reading-progress');
      if (!bar || !articleEl) return;

      const rect = articleEl.getBoundingClientRect();
      const total = articleEl.offsetHeight - window.innerHeight;
      const scrolled = Math.min(Math.max(-rect.top, 0), Math.max(total, 1));
      const pct = total <= 0 ? (rect.bottom < window.innerHeight ? 100 : 0) : Math.round((scrolled / total) * 100);
      bar.style.width = pct + '%';
      if (wrap) {
        wrap.setAttribute('aria-valuenow', String(pct));
      }

      // Active TOC item
      let current = headings[0];
      for (const h of headings) {
        if (h.getBoundingClientRect().top <= 120) current = h;
      }
      document.querySelectorAll('.toc-link').forEach((link) => {
        const active = current && link.getAttribute('data-toc-for') === current.id;
        link.classList.toggle('text-primary-700', !!active);
        link.classList.toggle('dark:text-primary-300', !!active);
        link.classList.toggle('font-semibold', !!active);
        link.classList.toggle('border-primary-500', !!active);
      });
    }

    function onScroll() {
      updateProgress();
    }

    function init() {
      buildToc();
      updateProgress();
      if (!scrollBound) {
        scrollBound = true;
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
      }
    }

    init();
    document.addEventListener('astro:page-load', init);
  })();
</script>
