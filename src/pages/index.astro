---
import { defaultLang } from '../i18n/ui';
---

<!doctype html>
<html lang={defaultLang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline define:vars={{ defaultLang }}>
      window.location.replace('/' + defaultLang + '/' + window.location.hash);
    </script>
    <title>Redirecting...</title>
  </head>
</html>
