---
import Logo from './Logo.astro';
import NavLinks from './NavLinks.astro';
import LanguageDropdown from './LanguageDropdown.astro';
import ThemeToggle from '../ThemeToggle.astro';
import Search from '../Search.astro';
import { getLangFromUrl } from '../../utils/i18n';

const lang = getLangFromUrl(Astro.url);
const pathAfterLang = Astro.url.pathname.replace(new RegExp(`^/${lang}`), '') || '/';
---
<header
  id="site-header"
  class:list={[
    'sticky top-0 z-[100] bg-white/80 dark:bg-gray-900/80 backdrop-blur-md border-b border-gray-200/80 dark:border-gray-800/80',
    'px-4 transition-[height,box-shadow,background-color] duration-300 ease-out',
    'h-16 md:h-20',
    lang === 'ar' ? 'font-cairo' : ''
  ]}
  data-scrolled="false"
>
  <div class="max-w-7xl mx-auto h-full flex items-center justify-between gap-4">
    <Logo lang={lang} />
    <div class="flex items-center gap-3 md:gap-8">
      <NavLinks lang={lang} currentPath={pathAfterLang} />
      <div class="flex items-center gap-2 md:gap-4 border-s border-gray-200 dark:border-gray-700 ps-2 md:ps-6">
        <Search lang={lang} />
        <div class="flex items-center gap-2">
          <ThemeToggle lang={lang} />
          <LanguageDropdown lang={lang} />
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  #site-header[data-scrolled='true'] {
    height: 3.5rem;
    box-shadow:
      0 1px 0 rgb(15 23 42 / 0.04),
      0 8px 24px -12px rgb(15 23 42 / 0.18);
    background-color: color-mix(in oklab, white 88%, transparent);
  }
  :global(.dark) #site-header[data-scrolled='true'] {
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.04),
      0 12px 28px -14px rgb(0 0 0 / 0.55);
    background-color: color-mix(in oklab, var(--color-gray-900, #101828) 88%, transparent);
  }
  @media (min-width: 768px) {
    #site-header[data-scrolled='true'] {
      height: 4rem;
    }
  }
</style>

<script>
  let headerScrollBound = false;

  function syncHeaderScroll() {
    const header = document.getElementById('site-header');
    if (!header) return;
    const scrolled = window.scrollY > 12;
    header.dataset.scrolled = scrolled ? 'true' : 'false';
  }

  function initHeaderScroll() {
    syncHeaderScroll();
    if (headerScrollBound) return;
    headerScrollBound = true;
    window.addEventListener('scroll', syncHeaderScroll, { passive: true });
  }

  initHeaderScroll();
  document.addEventListener('astro:page-load', initHeaderScroll);
</script>
