---
import { useTranslations } from '../utils/i18n';

const { lang } = Astro.props;
const t = useTranslations(lang);
const isDev = import.meta.env.DEV;
---

<div id="search-container" class="relative">
  <!-- Desktop trigger -->
  <button
    id="search-button-desktop"
    type="button"
    class="hidden sm:flex items-center gap-3 px-4 py-2 w-48 lg:w-64 text-start text-sm text-gray-400 bg-gray-50 dark:bg-gray-800/50 border border-gray-200 dark:border-gray-700 rounded-xl hover:border-primary-500/50 dark:hover:border-primary-500/50 hover:bg-white dark:hover:bg-gray-800 transition-all group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-gray-900"
    aria-haspopup="dialog"
    aria-controls="search-modal"
  >
    <svg class="w-4 h-4 text-gray-400 group-hover:text-primary-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
    <span class="flex-1">{t('search.placeholder')}</span>
    <kbd class="hidden lg:inline-flex items-center gap-1 px-1.5 py-0.5 text-[10px] font-medium text-gray-400 bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded">
      <span class="text-xs" id="search-mod-key">⌘</span>K
    </kbd>
  </button>

  <!-- Mobile trigger -->
  <button
    id="search-button-mobile"
    type="button"
    class="sm:hidden p-2.5 text-gray-500 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-xl transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500"
    aria-label={t('search.placeholder')}
    aria-haspopup="dialog"
    aria-controls="search-modal"
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
  </button>
</div>

<div
  id="search-modal"
  class="hidden fixed inset-0 z-[110] overflow-y-auto bg-gray-950/60 backdrop-blur-sm p-4 pt-[10vh] sm:pt-[15vh]"
  role="dialog"
  aria-modal="true"
  aria-label={t('search.placeholder')}
  hidden
>
  <div
    id="search-modal-content"
    class="max-w-2xl mx-auto bg-white dark:bg-gray-900 rounded-2xl shadow-2xl border border-gray-200 dark:border-gray-800 overflow-hidden"
  >
    <div class="p-5 border-b border-gray-100 dark:border-gray-800 flex items-center gap-4">
      <svg class="w-6 h-6 text-primary-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input
        type="search"
        id="search-input"
        placeholder={t('search.placeholder')}
        class="flex-1 bg-transparent border-none focus:ring-0 text-xl text-gray-900 dark:text-white placeholder-gray-400 outline-none"
        autocomplete="off"
        aria-controls="search-results"
        aria-autocomplete="list"
      />
      <button
        id="close-search"
        type="button"
        class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 p-1 rounded-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500"
        aria-label={t('search.close')}
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>

    <div
      id="search-results"
      class="max-h-[50vh] overflow-y-auto p-3 space-y-1"
      role="listbox"
      aria-label={t('search.placeholder')}
    >
      {isDev ? (
        <div class="p-8 text-center" data-search-empty>
          <div class="inline-flex p-3 rounded-full bg-amber-50 dark:bg-amber-900/20 text-amber-600 dark:text-amber-400 mb-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
          </div>
          <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">{t('search.devMode')}</h3>
          <p class="text-gray-500 dark:text-gray-400 text-sm max-w-sm mx-auto leading-relaxed">
            {t('search.devModeDesc')}
          </p>
        </div>
      ) : (
        <div class="p-8 text-center" data-search-empty>
          <p class="text-gray-500 dark:text-gray-400 text-sm max-w-sm mx-auto leading-relaxed">
            {t('search.hint')}
          </p>
        </div>
      )}
    </div>

    <div
      id="search-status"
      class="sr-only"
      aria-live="polite"
      aria-atomic="true"
    ></div>

    <div class="px-5 py-3 bg-gray-50 dark:bg-gray-800/50 border-t border-gray-100 dark:border-gray-800 flex justify-between items-center text-[11px] text-gray-400 font-medium">
      <div class="flex items-center gap-4">
        <span class="flex items-center gap-1.5"><kbd class="px-1 py-0.5 bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded shadow-sm">↵</kbd> {t('search.select')}</span>
        <span class="flex items-center gap-1.5"><kbd class="px-1 py-0.5 bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded shadow-sm">↑↓</kbd> {t('search.navigate')}</span>
        <span class="hidden sm:flex items-center gap-1.5"><kbd class="px-1 py-0.5 bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded shadow-sm">esc</kbd> {t('search.close')}</span>
      </div>
      <div class="flex items-center gap-1">
        {t('search.powered')} <span class="text-primary-600 dark:text-primary-400 font-bold">Pagefind</span>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ lang, noResultsText: t('search.noResults'), loadingText: t('search.loading'), resultsCountText: t('search.resultsCount'), hintText: t('search.hint') }}>
  (function () {
    let pagefind;
    let activeIndex = -1;
    let resultLinks = [];
    let lastTrigger = null;

    const searchButtons = [
      document.getElementById('search-button-desktop'),
      document.getElementById('search-button-mobile')
    ].filter(Boolean);

    const searchModal = document.getElementById('search-modal');
    const searchInput = document.getElementById('search-input');
    const searchResults = document.getElementById('search-results');
    const searchStatus = document.getElementById('search-status');
    const closeButton = document.getElementById('close-search');
    const modKey = document.getElementById('search-mod-key');

    if (modKey && !(/Mac|iPhone|iPad|iPod/.test(navigator.platform) || navigator.userAgent.includes('Mac'))) {
      modKey.textContent = 'Ctrl';
    }

    if (searchModal && searchModal.parentElement !== document.body) {
      document.body.appendChild(searchModal);
    }

    const emptyHintHtml = () =>
      `<div class="p-8 text-center" data-search-empty><p class="text-gray-500 dark:text-gray-400 text-sm max-w-sm mx-auto leading-relaxed">${hintText}</p></div>`;

    const getFocusable = () => {
      if (!searchModal) return [];
      return Array.from(
        searchModal.querySelectorAll(
          'button:not([disabled]), [href], input:not([disabled]), [tabindex]:not([tabindex="-1"])'
        )
      );
    };

    const setActiveResult = (index) => {
      resultLinks.forEach((el, i) => {
        const active = i === index;
        el.setAttribute('aria-selected', active ? 'true' : 'false');
        el.classList.toggle('bg-primary-50', active);
        el.classList.toggle('dark:bg-primary-900/20', active);
        el.classList.toggle('border-primary-100', active);
        el.classList.toggle('dark:border-primary-800', active);
        if (active) el.scrollIntoView({ block: 'nearest' });
      });
      activeIndex = index;
    };

    const openSearch = async (trigger) => {
      if (!searchModal) return;
      lastTrigger = trigger || document.activeElement;
      searchModal.classList.remove('hidden');
      searchModal.removeAttribute('hidden');
      document.body.style.overflow = 'hidden';
      searchInput?.focus();

      if (!pagefind) {
        if (searchStatus) searchStatus.textContent = loadingText;
        try {
          pagefind = await import('/pagefind/pagefind.js');
          await pagefind.options({ primaryColor: '#3f5f8a' });
        } catch (e) {
          pagefind = null;
        }
        if (searchStatus) searchStatus.textContent = '';
      }
    };

    const closeSearch = () => {
      if (!searchModal) return;
      searchModal.classList.add('hidden');
      searchModal.setAttribute('hidden', '');
      document.body.style.overflow = '';
      activeIndex = -1;
      resultLinks = [];
      if (lastTrigger && typeof lastTrigger.focus === 'function') {
        lastTrigger.focus();
      }
    };

    searchButtons.forEach((btn) =>
      btn?.addEventListener('click', () => openSearch(btn))
    );
    closeButton?.addEventListener('click', closeSearch);

    searchModal?.addEventListener('click', (e) => {
      if (e.target === searchModal) closeSearch();
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'k' && (e.metaKey || e.ctrlKey)) {
        e.preventDefault();
        if (searchModal && !searchModal.classList.contains('hidden')) {
          closeSearch();
        } else {
          openSearch(document.activeElement);
        }
        return;
      }

      if (searchModal?.classList.contains('hidden')) return;

      if (e.key === 'Escape') {
        e.preventDefault();
        closeSearch();
        return;
      }

      if (e.key === 'Tab') {
        const focusable = getFocusable();
        if (focusable.length === 0) return;
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
        return;
      }

      if (resultLinks.length === 0) return;

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        setActiveResult(activeIndex < resultLinks.length - 1 ? activeIndex + 1 : 0);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        setActiveResult(activeIndex > 0 ? activeIndex - 1 : resultLinks.length - 1);
      } else if (e.key === 'Enter' && activeIndex >= 0 && resultLinks[activeIndex]) {
        e.preventDefault();
        resultLinks[activeIndex].click();
      }
    });

    let debounceTimer;
    searchInput?.addEventListener('input', async (e) => {
      const query = e.target.value;
      clearTimeout(debounceTimer);
      activeIndex = -1;
      resultLinks = [];

      if (!query) {
        searchResults.innerHTML = emptyHintHtml();
        if (searchStatus) searchStatus.textContent = '';
        return;
      }

      debounceTimer = setTimeout(async () => {
        if (!pagefind) {
          searchResults.innerHTML = `<div class="p-12 text-center"><p class="text-gray-500 dark:text-gray-400 font-medium">${noResultsText}</p></div>`;
          return;
        }

        if (searchStatus) searchStatus.textContent = loadingText;
        const search = await pagefind.search(query);

        const filteredResults = [];
        for (const result of search.results) {
          const data = await result.data();
          if (data.url.includes(`/${lang}/`)) {
            filteredResults.push(data);
          }
          if (filteredResults.length >= 6) break;
        }

        if (filteredResults.length === 0) {
          searchResults.innerHTML = `
            <div class="p-12 text-center">
              <p class="text-gray-500 dark:text-gray-400 font-medium">${noResultsText}</p>
            </div>
          `;
          if (searchStatus) searchStatus.textContent = noResultsText;
          return;
        }

        searchResults.innerHTML = '';
        resultLinks = [];
        filteredResults.forEach((data, i) => {
          const a = document.createElement('a');
          a.href = data.url;
          a.role = 'option';
          a.id = `search-result-${i}`;
          a.setAttribute('aria-selected', 'false');
          a.className =
            'block p-4 hover:bg-primary-50 dark:hover:bg-primary-900/20 rounded-xl transition-all group border border-transparent hover:border-primary-100 dark:hover:border-primary-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500';
          a.innerHTML = `
            <div class="flex items-center justify-between gap-4">
              <div class="flex-1 min-w-0">
                <h3 class="font-bold text-gray-900 dark:text-white group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">${data.meta.title || ''}</h3>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-1.5 line-clamp-2 leading-relaxed">${data.excerpt || ''}</p>
              </div>
              <div class="hidden sm:block text-primary-500 opacity-0 group-hover:opacity-100 transition-opacity shrink-0 rtl:rotate-180">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
              </div>
            </div>
          `;
          searchResults.appendChild(a);
          resultLinks.push(a);
        });

        if (searchStatus) {
          searchStatus.textContent = resultsCountText.replace('{n}', String(filteredResults.length));
        }
      }, 150);
    });
  })();
</script>
