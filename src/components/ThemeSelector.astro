---
import { useTranslations } from '../utils/i18n';

const { lang } = Astro.props;
const t = useTranslations(lang);

const themes = [
  { id: 'modern', label: t('theme.modern'), color: '#3b82f6' },
  { id: 'midnight', label: t('theme.midnight'), color: '#6366f1' },
  { id: 'forest', label: t('theme.forest'), color: '#10b981' },
  { id: 'galactic', label: t('theme.galactic'), color: '#a855f7' },
];
---

<div class="relative inline-block text-left">
  <button
    type="button"
    class="inline-flex items-center gap-2 p-2 text-sm rounded-xl hover:bg-bg-hover transition-colors"
    id="theme-button"
    aria-expanded="false"
    aria-haspopup="true"
    aria-label={t('theme.select')}
  >
    <svg class="w-5 h-5 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
    </svg>
  </button>

  <div
    class="hidden absolute right-0 mt-2 w-44 rounded-xl shadow-lg bg-bg-card ring-1 ring-border focus:outline-none rtl:right-auto rtl:left-0 z-[200] border border-border overflow-hidden"
    role="menu"
    id="theme-menu"
  >
    <div class="py-1" role="none">
      {themes.map((theme) => (
        <button
          type="button"
          class="theme-option w-full text-left px-4 py-2.5 text-sm hover:bg-bg-hover transition-colors flex items-center gap-3"
          data-theme={theme.id}
          role="menuitem"
        >
          <span class="w-3 h-3 rounded-full" style={`background-color: ${theme.color}`}></span>
          <span class="text-text-secondary">{theme.label}</span>
        </button>
      ))}
    </div>
    <div class="border-t border-border-subtle py-1">
      <button
        type="button"
        id="mode-toggle"
        class="w-full text-left px-4 py-2.5 text-sm hover:bg-bg-hover transition-colors flex items-center gap-3 text-text-secondary"
        role="menuitem"
      >
        <svg id="mode-icon-sun" class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 9H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m12.728 0l-.707-.707M6.343 6.343l-.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z" />
        </svg>
        <svg id="mode-icon-moon" class="w-4 h-4 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
        <span id="mode-label">{t('theme.toggleMode')}</span>
      </button>
    </div>
  </div>
</div>

<script is:inline>
  const themeButton = document.getElementById('theme-button');
  const themeMenu = document.getElementById('theme-menu');
  const modeToggle = document.getElementById('mode-toggle');

  const toggleMenu = () => {
    const isHidden = themeMenu?.classList.contains('hidden');
    themeMenu?.classList.toggle('hidden');
    themeButton?.setAttribute('aria-expanded', String(isHidden));
  };

  const hideMenu = (e) => {
    if (!themeButton?.contains(e.target) && !themeMenu?.contains(e.target)) {
      themeMenu?.classList.add('hidden');
      themeButton?.setAttribute('aria-expanded', 'false');
    }
  };

  themeButton?.addEventListener('click', toggleMenu);
  document.addEventListener('click', hideMenu);

  document.querySelectorAll('.theme-option').forEach((btn) => {
    btn.addEventListener('click', () => {
      const theme = btn.dataset.theme;
      if (theme && window.__switchTheme) {
        window.__switchTheme(theme);
      }
      themeMenu?.classList.add('hidden');
      themeButton?.setAttribute('aria-expanded', 'false');
    });
  });

  modeToggle?.addEventListener('click', () => {
    if (window.__switchMode) {
      window.__switchMode();
    }
    themeMenu?.classList.add('hidden');
    themeButton?.setAttribute('aria-expanded', 'false');
  });
</script>
